{
  "info": {
    "name": "AgroKeep - Admin Bookings",
    "description": "Covers the 4 admin booking endpoints: list, create, get single, cancel. Run requests top-to-bottom inside a single Postman run so variables chain automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3700/api/v1" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "hubId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "dropOffDate", "value": "" },
    { "key": "pickUpDate", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login (Admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/user/login", "host": ["{{baseUrl}}"], "path": ["user", "login"] },
        "description": "Requires a user in your DB whose role is \"admin\" and emailVerified is true. The register endpoint always creates role: \"client\" — flip a user's role to \"admin\" directly in MongoDB if you don't have one yet. On success the session cookie (\"sessionId\") is stored by Postman's cookie jar and sent automatically on every request after this."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeded (200)', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('Logged-in user is an admin', () => pm.expect(body.data.role).to.eql('admin'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get All Storage Hubs (fetch a hubId)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/hub/all", "host": ["{{baseUrl}}"], "path": ["hub", "all"] },
        "description": "Not one of the 4 admin endpoints, but you need a real hubId + a crop it supports + its unit type before you can call Create Booking."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Fetched hubs (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (Array.isArray(body.data) && body.data.length > 0) {",
              "  const hub = body.data[0];",
              "  pm.collectionVariables.set('hubId', hub._id);",
              "  console.log('Using hub:', hub.name, '| supportedCrops:', hub.supportedCrops, '| unitType:', hub.unitType);",
              "} else {",
              "  console.warn('No storage hubs found — create one first via the Storage Hubs admin screen.');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create Booking (Admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hubId\": \"{{hubId}}\",\n  \"fullName\": \"Adewale Anuoluwapo\",\n  \"phoneNumber\": \"+2348034567899\",\n  \"email\": \"adewale.a@mail.com\",\n  \"selectedCrop\": \"Maize\",\n  \"quantity\": 120,\n  \"unitType\": \"bags\",\n  \"dropOffDate\": \"{{dropOffDate}}\",\n  \"pickUpDate\": \"{{pickUpDate}}\",\n  \"specialInstructions\": \"I'll arrive around 10 AM, I need truck access.\",\n  \"paymentType\": \"deposit\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/admin/create-booking", "host": ["{{baseUrl}}"], "path": ["admin", "create-booking"] },
        "description": "IMPORTANT: change \"selectedCrop\" and \"unitType\" to match whatever the hub from request #2 actually supports (see the Postman console log it prints), or you'll get a 400 from validateHubForBooking. Set \"paymentType\" to \"full\" to test the full-payment path instead of the 30% deposit path."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function isSunday(d) { return d.getDay() === 0; }",
              "function futureNonSundayIso(offsetDays) {",
              "  const d = new Date();",
              "  d.setDate(d.getDate() + offsetDays);",
              "  while (isSunday(d)) { d.setDate(d.getDate() + 1); }",
              "  // Pin to UTC noon so the date component can't shift across a day",
              "  // boundary once the server re-parses it in a different timezone.",
              "  return new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate(), 12, 0, 0)).toISOString();",
              "}",
              "pm.collectionVariables.set('dropOffDate', futureNonSundayIso(3));",
              "pm.collectionVariables.set('pickUpDate', futureNonSundayIso(3 + 56));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Booking created (201)', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('bookingId', body.data.booking._id);",
              "  pm.test('Payment record was created', () => pm.expect(body.data.payment).to.not.be.undefined);",
              "  pm.test('paymentStatus matches paymentType', () => {",
              "    const sentFull = JSON.parse(pm.request.body.raw).paymentType === 'full';",
              "    pm.expect(body.data.booking.paymentStatus).to.eql(sentFull ? 'fully_paid' : 'partial_deposit_paid');",
              "  });",
              "} else {",
              "  console.error('Create booking failed:', pm.response.text());",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get All Bookings (Admin)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/admin/all-bookings?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "all-bookings"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "status", "value": "confirmed", "disabled": true },
            { "key": "state", "value": "", "disabled": true },
            { "key": "storageHub", "value": "", "disabled": true },
            { "key": "cropType", "value": "", "disabled": true },
            { "key": "paymentStatus", "value": "", "disabled": true },
            { "key": "startDate", "value": "", "disabled": true },
            { "key": "endDate", "value": "", "disabled": true }
          ]
        },
        "description": "Enable/edit the disabled query params to test filters. Note: `status` must be one of pending|confirmed|in_storage|completed|cancelled (lowercase, exact match) — there's no \"active\" value in the schema, so if your frontend's dropdown sends that literally, this filter will silently return zero rows."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('List fetched (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Response has pagination block', () => pm.expect(body.data.pagination).to.not.be.undefined);",
              "if (body.data.bookings?.length) {",
              "  pm.test('The booking we just created is in the list', () => {",
              "    const ids = body.data.bookings.map(b => b._id);",
              "    pm.expect(ids).to.include(pm.collectionVariables.get('bookingId'));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Get Single Booking (Admin)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/admin/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Booking details fetched (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('hubName resolved (populate bug regression check)', () => {",
              "  pm.expect(body.data.booking.reservationSummary.hubName).to.not.eql('N/A');",
              "});",
              "pm.test('Payment card reflects the admin-recorded payment', () => {",
              "  pm.expect(body.data.booking.payment.method).to.eql('cash');",
              "  pm.expect(body.data.booking.payment.reference).to.match(/^ADM-/);",
              "});",
              "",
              "// 400 for a malformed id — sanity check the validateParams wiring",
              "pm.sendRequest({",
              "  url: pm.variables.get('baseUrl') + '/admin/booking/not-a-valid-id',",
              "  method: 'GET',",
              "  header: { Cookie: pm.request.headers.get('Cookie') || undefined }",
              "}, (err, res) => {",
              "  pm.test('Malformed id -> 400, not a raw 500/CastError', () => pm.expect(res.code).to.eql(400));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Cancel Booking (Admin) - should succeed",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/admin/booking/{{bookingId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "booking", "{{bookingId}}", "cancel"]
        },
        "description": "The booking created in step 3 defaults to bookingStatus \"confirmed\", which is cancellable. Run this once — a second run should fail (see request #7)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cancelled (200)', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.test('bookingStatus is now cancelled', () => {",
              "    pm.expect(pm.response.json().data.booking.bookingStatus).to.eql('cancelled');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Cancel Booking (Admin) - should fail (already cancelled)",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/admin/booking/{{bookingId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "booking", "{{bookingId}}", "cancel"]
        },
        "description": "Re-cancelling an already-cancelled booking must be rejected with a 400."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Second cancel rejected (400)', () => pm.response.to.have.status(400));",
              "pm.test('Error message names the current status', () => {",
              "  pm.expect(pm.response.json().message).to.include('cancelled');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
